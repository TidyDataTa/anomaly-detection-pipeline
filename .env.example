# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Warehouse -------------------------------------------------------------
# Standalone runs: a plain DSN.
ANOMALY_DATABASE_URL=postgresql://user:password@localhost:5432/warehouse
# Airflow runs: the connection id instead — takes precedence when set.
# ANOMALY_POSTGRES_CONN_ID=warehouse_rw

# --- Alerting --------------------------------------------------------------
ANOMALY_TELEGRAM_BOT_TOKEN=123456:replace-me
ANOMALY_TELEGRAM_CHAT_ID=-1000000000000
